# Public backend API base URL for device/EAS builds (must end with /api/)
# Local Worker: http://10.0.2.2:8787/api/ (Android emulator) or your machine LAN IP
# Production: https://api.lardermind.com/api/
EXPO_PUBLIC_API_BASE_URL=https://api.lardermind.com/api/

# Web OAuth Client ID (same as Worker GOOGLE_CLIENT_ID). Used as GoogleSignin webClientId
# so the ID token aud matches backend verification. Android OAuth client is Console-only
# (package + SHA-1) and is NOT this value.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=603047692060-llk1cjf1b0f5bpdb9it5cvogk2b8haio.apps.googleusercontent.com
