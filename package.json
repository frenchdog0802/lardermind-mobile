{
  "name": "LarderMind-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:e2e": "node scripts/build-android-e2e.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:bottom-nav": "maestro test .maestro/bottom-nav-last-tab.yaml",
    "test:e2e:smoke": "maestro test .maestro/smoke.yaml",
    "verify": "npm run test",
    "verify:strict": "npm run verify:types && npm run test",
    "verify:types": "tsc --noEmit",
    "verify:all": "node -e \"require('child_process').execSync(process.platform==='win32'?'scripts\\\\\\\\verify.cmd':'bash scripts/verify.sh',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/stack": "^7.6.13",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-react-native": "^0.57.3",
    "babel-preset-expo": "^54.0.9",
    "expo": "~54.0.30",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.3.6",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-iap": "^14.7.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.31.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
