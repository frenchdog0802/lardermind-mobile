{
  "expo": {
    "scheme": "lardermind",
    "name": "LarderMind",
    "slug": "lardermind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F0E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lardermind.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "LarderMind uses the camera to photograph groceries for your pantry.",
        "NSPhotoLibraryUsageDescription": "LarderMind uses your photo library to add groceries to your pantry."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0E8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lardermind.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "react-native-iap",
      "expo-font",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "skipOnboarding": true,
          "showMenuAtLaunch": false,
          "embeddedBundle": true
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LarderMind to access your photos to add groceries to your pantry.",
          "cameraPermission": "Allow LarderMind to use the camera to photograph groceries for your pantry."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf38de84-b63d-4d79-99fa-2dc29373f4d0"
      }
    },
    "owner": "bertjiayu"
  }
}
